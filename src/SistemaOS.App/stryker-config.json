{
  "stryker-config": {
    "mutate": [
      "*.cs",
      "ViewModels/**/*.cs",
      "Views/**/*.cs",
      "Services/**/*.cs",
      "Helpers/**/*.cs"
    ],
    "ignore-mutations": [
