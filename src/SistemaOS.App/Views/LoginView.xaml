<Window x:Class="SistemaOS.App.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SistemaOS.App.ViewModels"
        xmlns:helpers="clr-namespace:SistemaOS.App.Helpers"
        Title="Sistema OS - Login" Height="580" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#E6E8EF"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Conversores -->
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:BooleanInverterConverter x:Key="BooleanInverterConverter"/>

        <!-- Estilo Label -->
        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B91A7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- TextBox - Template corrigido para mostrar texto -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2C3144"/>
            <Setter Property="Background" Value="#181B24"/>
            <Setter Property="Foreground" Value="#E6E8EF"/>
            <Setter Property="CaretBrush" Value="#6C5CE7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Focusable="False"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden"
                                        Padding="{TemplateBinding Padding}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6C5CE7"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A4F6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox - Template corrigido -->
        <Style x:Key="PasswordField" TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2C3144"/>
            <Setter Property="Background" Value="#181B24"/>
            <Setter Property="Foreground" Value="#E6E8EF"/>
            <Setter Property="CaretBrush" Value="#6C5CE7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Focusable="False"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden"
                                        Padding="{TemplateBinding Padding}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6C5CE7"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A4F6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão primário -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#6C5CE7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão secundário (Cancelar) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B91A7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2C3144"/>
            <Setter Property="Padding" Value="24,10"/>
        </Style>
    </Window.Resources>

    <Border Background="#181B24"
            CornerRadius="16"
            BorderBrush="#2C3144"
            BorderThickness="1"
            Margin="16">

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo / Título -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,20,0,8">
                <TextBlock Text="Sistema OS"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#6C5CE7"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Faça login para continuar"
                           FontSize="14"
                           Foreground="#8B91A7"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Separador -->
            <Border Grid.Row="1" Height="1" Background="#2C3144" Margin="0,0,0,24"/>

            <!-- Formulário -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <!-- Login -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Usuário" Style="{StaticResource Rotulo}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputField}"
                             ToolTip="Seu nome de usuário"
                             helpers:FormatadorMascara.Tipo="Nenhuma"/>
                </StackPanel>

                <!-- Senha -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Senha" Style="{StaticResource Rotulo}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="SenhaBox"
                                 Style="{StaticResource PasswordField}"
                                 ToolTip="Sua senha"
                                 PasswordChanged="SenhaBox_PasswordChanged"/>
                </StackPanel>

                <!-- Mensagem de erro -->
                <TextBlock Text="{Binding Mensagem}"
                           Foreground="#E74C3C"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Visibility="{Binding Mensagem, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Botões: Entrar e Cancelar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Entrar"
                            Command="{Binding EntrarCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding Carregando, Converter={StaticResource BooleanInverterConverter}}"
                            MinWidth="140"
                            Margin="0,0,12,0"
                            IsDefault="True"/>
                    <Button Content="Cancelar"
                            Command="{Binding CancelarCommand}"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="140"
                            IsCancel="True"/>
                </StackPanel>
            </StackPanel>

            <!-- Rodapé -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,24,0,8">
                <TextBlock Text="Sistema OS v1.0" FontSize="11" Foreground="#8B91A7"/>
                <TextBlock Text="Login padrão: admin / admin123" FontSize="10" Foreground="#5A5F7A" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>