<UserControl x:Class="SistemaOS.App.Views.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SistemaOS.App.Helpers"
             xmlns:local="clr-namespace:SistemaOS.App.Helpers"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Language="pt-BR">

    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NullToTextConverter x:Key="NullToTextConverter"/>
        <local:EstoqueStatusTextConverter x:Key="EstoqueStatusTextConverter"/>
        <local:EstoqueStatusColorConverter x:Key="EstoqueStatusColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Título + KPIs -->
            <RowDefinition Height="Auto"/> <!-- 1: Barra de Pesquisa / Filtros -->
            <RowDefinition Height="Auto"/> <!-- 2: Formulário / Movimentação -->
            <RowDefinition Height="*"/>    <!-- 3: DataGrid Produtos -->
            <RowDefinition Height="Auto"/> <!-- 4: Movimentações do produto selecionado -->
            <RowDefinition Height="Auto"/> <!-- 5: Mensagem de status -->
        </Grid.RowDefinitions>

        <!-- Título + KPIs -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="16" CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Estoque de Peças" FontSize="24"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="12,8" Margin="0,0,16,0" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total: " Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalProdutos}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,8" Margin="0,0,16,0" CornerRadius="8" Background="#F39C12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Baixo: " Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProdutosBaixoEstoque}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,8" Margin="0,0,16,0" CornerRadius="8" Background="#E74C3C">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Zerados: " Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProdutosSemEstoque}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,8" Margin="0,0,16,0" CornerRadius="8" Background="#27AE60">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Valor: " Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ValorTotalEstoque, StringFormat='R$ {0:N2}'}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <CheckBox Grid.Column="2" Content="Só baixo estoque"
                          IsChecked="{Binding MostrarApenasBaixoEstoque}"
                          VerticalAlignment="Center" Margin="16,0,0,0"
                          Foreground="{DynamicResource TextBrush}"/>

                <Button Grid.Column="3" Content="Exportar CSV"
                        Command="{Binding ExportarCsvCommand}"
                        MinWidth="120" Margin="16,0,8,0" Padding="12,6"
                        Background="#3498DB" Foreground="White" FontWeight="SemiBold"/>

                <Button Grid.Column="4" Content="Novo Produto"
                        Command="{Binding NovoCommand}"
                        MinWidth="130" Margin="8,0,0,0" Padding="12,6"
                        Background="#27AE60" Foreground="White" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Barra de Pesquisa -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Pesquisar:" VerticalAlignment="Center"
                       Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>

            <TextBox Grid.Column="1" Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Pesquise por Código, Nome ou Descrição"/>
        </Grid>

        <!-- Formulário (visível em modo edição) -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="16" CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1"
                Visibility="{Binding ModoEdicao, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header do formulário -->
                <TextBlock Grid.Row="0"
                           Text="{Binding ProdutoSelecionado.Nome, Converter={StaticResource NullToTextConverter}, ConverterParameter='Editar: {0}', FallbackValue='Novo Produto'}"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <!-- Linha 1: Código, Nome, Unidade -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Código (SKU)" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Unidade" Style="{StaticResource Rotulo}"/>
                        <ComboBox ItemsSource="{Binding OpcoesUnidadeMedida}"
                                  SelectedItem="{Binding UnidadeMedida}"
                                  IsEditable="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Salvar" Command="{Binding SalvarCommand}" MinWidth="100" Margin="0,0,8,0" Padding="16,6"/>
                        <Button Content="Cancelar" Command="{Binding CancelarCommand}" MinWidth="100" Padding="16,6"/>
                    </StackPanel>
                </Grid>

                <!-- Linha 2: Descrição, Preços, Qtd Mínima -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Descrição" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Preço Custo" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding PrecoCusto, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Preço Venda" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding PrecoVenda, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Qtd. Mínima" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding QuantidadeMinima, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Movimentação (visível quando produto selecionado e não em edição) -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="16" CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1"
                Visibility="{Binding ModoEdicao, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Movimentar:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,0,0"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tipo" Style="{StaticResource Rotulo}"/>
                    <ComboBox ItemsSource="{Binding OpcoesTipoMovimento}"
                              SelectedItem="{Binding TipoMovimento}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Quantidade" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding QuantidadeMovimento, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Preço Unit. (opcional)" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding PrecoUnitarioMovimento, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"/>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                    <TextBlock Text="Observação" Style="{StaticResource Rotulo}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding ObservacaoMovimento, UpdateSourceTrigger=PropertyChanged}"
                                 Width="250" Margin="0,0,8,0"/>
                        <Button Content="Registrar" Command="{Binding MovimentarCommand}"
                                MinWidth="110" Padding="16,6"
                                Background="#27AE60" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabela de Produtos -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Produtos}"
                  SelectedItem="{Binding ProdutoSelecionado, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowDetailsVisibilityMode="Collapsed">

            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding EditarCommand}" />
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Unid." Binding="{Binding UnidadeMedida}" Width="60"/>
                <DataGridTextColumn Header="Custo" Binding="{Binding PrecoCusto, StringFormat='R$ {0:N2}'}" Width="90"/>
                <DataGridTextColumn Header="Venda" Binding="{Binding PrecoVenda, StringFormat='R$ {0:N2}'}" Width="90"/>
                <DataGridTextColumn Header="Atual" Binding="{Binding QuantidadeAtual}" Width="70"/>
                <DataGridTextColumn Header="Mínima" Binding="{Binding QuantidadeMinima}" Width="70"/>
                <DataGridTextColumn Header="Valor Estoque" Binding="{Binding ValorEstoque, StringFormat='R$ {0:N2}'}" Width="110"/>

                <!-- Status usando MultiBinding -->
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource EstoqueStatusTextConverter}">
                                        <Binding Path="SemEstoque"/>
                                        <Binding Path="EstoqueBaixo"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource EstoqueStatusColorConverter}">
                                        <Binding Path="SemEstoque"/>
                                        <Binding Path="EstoqueBaixo"/>
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SemEstoque}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE"/>
                            <Setter Property="Foreground" Value="#1B1E2B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EstoqueBaixo}" Value="True">
                            <Setter Property="Background" Value="#FFF8E1"/>
                            <Setter Property="Foreground" Value="#1B1E2B"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Movimentações do produto selecionado -->
        <Border Grid.Row="4" Margin="0,16,0,0" Padding="16" CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1"
                Visibility="{Binding ProdutoSelecionado, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Histórico de Movimentações"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Movimentos}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          MaxHeight="200">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding DataMovimento, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoDescricao}" Width="100"/>
                        <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="90"/>
                        <DataGridTextColumn Header="Preço Unit." Binding="{Binding PrecoUnitario, StringFormat='R$ {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding ValorTotal, StringFormat='R$ {0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="*"/>
                        <DataGridTextColumn Header="OS Vinculada" Binding="{Binding OrdemServicoId, StringFormat='OS #{0}'}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Mensagem de status -->
        <TextBlock Grid.Row="5" Text="{Binding Mensagem}"
                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                   Margin="0,8,0,0" HorizontalAlignment="Center"/>
    </Grid>
</UserControl>