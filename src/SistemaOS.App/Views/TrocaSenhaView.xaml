<Window x:Class="SistemaOS.App.Views.TrocaSenhaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SistemaOS.App.ViewModels"
        xmlns:helpers="clr-namespace:SistemaOS.App.Helpers"
        mc:Ignorable="d"
        Title="Trocar Senha - Sistema OS"
        Height="600" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinHeight="550" MinWidth="520"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        SizeToContent="Height">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="30"
                    MinWidth="440"
                    MaxWidth="500"
                    BorderBrush="{DynamicResource BorderBrushTheme}"
                    BorderThickness="1">

                <StackPanel>
                <!-- Título -->
                <TextBlock Text="🔐 Troca de Senha Obrigatória"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="Você está acessando o sistema pela primeira vez.&#x0a;Por segurança, defina uma nova senha pessoal."
                           FontSize="14"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,24" />

                <!-- Senha Atual -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Senha Atual (inicial)"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="SenhaAtualBox"
                                 PasswordChanged="SenhaAtualBox_PasswordChanged"
                                 Height="40"
                                 FontSize="15"
                                 Background="{DynamicResource SurfaceAltBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrushTheme}"
                                 BorderThickness="1"
                                 Padding="12,8"
                                 CaretBrush="{DynamicResource AccentBrush}" />
                </StackPanel>

                <!-- Nova Senha -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Nova Senha (mín. 8 caracteres)"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="NovaSenhaBox"
                                 PasswordChanged="NovaSenhaBox_PasswordChanged"
                                 Height="40"
                                 FontSize="15"
                                 Background="{DynamicResource SurfaceAltBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrushTheme}"
                                 BorderThickness="1"
                                 Padding="12,8"
                                 CaretBrush="{DynamicResource AccentBrush}" />
                </StackPanel>

                <!-- Confirmar Nova Senha -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Confirmar Nova Senha"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="ConfirmarNovaSenhaBox"
                                 PasswordChanged="ConfirmarNovaSenhaBox_PasswordChanged"
                                 Height="40"
                                 FontSize="15"
                                 Background="{DynamicResource SurfaceAltBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrushTheme}"
                                 BorderThickness="1"
                                 Padding="12,8"
                                 CaretBrush="{DynamicResource AccentBrush}" />
                </StackPanel>

                <!-- Mensagem de erro/sucesso -->
                <TextBlock x:Name="MensagemText"
                           Text="{Binding Mensagem}"
                           FontSize="13"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,16"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensagemErro}" Value="True">
                                    <Setter Property="Foreground" Value="#E74C3C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MensagemErro}" Value="False">
                                    <Setter Property="Foreground" Value="#27AE60" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Botões -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Cancelar"
                            Command="{Binding CancelarCommand}"
                            Width="120"
                            Height="42"
                            Margin="0,0,12,0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource BorderBrushTheme}"
                            BorderThickness="1" />

                    <Button Content="Salvar e Continuar"
                            Command="{Binding SalvarCommand}"
                            Width="180"
                            Height="42"
                            IsDefault="True"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0" />
                </StackPanel>

                <!-- Indicador de carregamento -->
                <ProgressBar Height="4"
                             Margin="0,16,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding Carregando, Converter={StaticResource BoolToVisibility}}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Grid>
</Window>