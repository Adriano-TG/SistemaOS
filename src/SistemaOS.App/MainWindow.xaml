<Window x:Class="SistemaOS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SistemaOS.App.ViewModels"
        xmlns:views="clr-namespace:SistemaOS.App.Views"
        xmlns:core="clr-namespace:SistemaOS.Core.Entities;assembly=SistemaOS.Core"
        xmlns:helpers="clr-namespace:SistemaOS.App.Helpers"
        Title="Sistema OS" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <helpers:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
            <views:ClientesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfiguracoesViewModel}">
            <views:ConfiguracoesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EstoqueViewModel}">
            <views:EstoqueView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmConstrucaoViewModel}">
            <views:EmConstrucaoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdensViewModel}">
            <views:OrdensView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PdvViewModel}">
            <views:PdvView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
            <views:UsuariosView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushTheme}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="Sistema OS"
                           FontSize="20" FontWeight="Bold" Margin="8,8,0,24"/>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Content="Dashboard"
                            Command="{Binding IrParaDashboardCommand}"/>
                    <Button Style="{StaticResource NavButton}" Content="Clientes"
                            Command="{Binding IrParaClientesCommand}"/>
                    <Button Style="{StaticResource NavButton}" Content="Ordens de Serviço"
                            Command="{Binding IrParaOrdensCommand}"/>
                    <Button Style="{StaticResource NavButton}" Content="Estoque de Peças"
                            Command="{Binding IrParaEstoqueCommand}"/>
                    <Button Style="{StaticResource NavButton}" Content="👥 Usuários"
                            Command="{Binding IrParaUsuariosCommand}"
                            Visibility="{Binding UsuarioLogado.Role, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Admin}"/>
                    <Button Style="{StaticResource NavButton}" Content="PDV"
                            Command="{Binding IrParaPdvCommand}"/>
                    <Button Style="{StaticResource NavButton}" Content="Financeiro"
                            Command="{Binding IrParaFinanceiroCommand}"/>
                    <Button Style="{StaticResource NavButton}" Content="Configurações"
                            Command="{Binding IrParaConfiguracoesCommand}"/>
                </StackPanel>

                <!-- Usuário logado + Logout (fixo no rodapé) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,16,8,0">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="32" Height="32" Fill="White">
                                <Ellipse.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=UserIcon}"/>
                                </Ellipse.OpacityMask>
                            </Ellipse>
                            <Path x:Name="UserIcon" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UsuarioLogado.Nome, FallbackValue='Usuário'}"
                                       Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource NavButton}" Content="Sair"
                            Command="{Binding LogoutCommand}"
                            Foreground="#E74C3C" Margin="0,8,0,0"
                            Background="Transparent" BorderBrush="#E74C3C" BorderThickness="1"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Área da tela atual -->
        <ContentControl Grid.Column="1" Margin="24"
                        Content="{Binding TelaAtual}"/>
    </Grid>
</Window>