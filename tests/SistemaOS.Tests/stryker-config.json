{
  "stryker-config": {
    "project": "SistemaOS.Core",
    "test-projects": [
      "SistemaOS.Tests"
    ],
    "ignore-mutations": [
      "**/Migrations/*.cs",
      "**/obj/**/*.cs",
      "**/bin/**/*.cs"
    ],
    "reporters": [
      "html",
      "cleartext",
      "progress",
      "json"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "concurrency": 4,
    "additional-timeout": 30000
  }
}